# Environment Configuration Template for MicroTask System
# Copy this file to .env or set environment variables in production

# Security & Session Secrets
SECRET_KEY=dev-secret-key-change-in-production-microtask-2026
JWT_SECRET_KEY=dev-jwt-secret-key-at-least-32-bytes-long-super-secure!
JWT_EXPIRES_HOURS=24

# Database Configuration (Relative to backend or absolute path)
# Default: instance/microtask.db
DATABASE_PATH=

# Server Network Configuration
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
